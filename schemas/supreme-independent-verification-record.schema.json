{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"SHIRMANI Supreme Independent Verification Record",
  "type":"object",
  "required":["record_id","source_record_id","claim_or_result","verification_scope","evidence_refs","independent_verifier","verification_method","reviewed_at","verification_state","limitations"],
  "properties":{
    "record_id":{"type":"string","minLength":1},
    "source_record_id":{"type":"string","minLength":1},
    "claim_or_result":{"type":"string","minLength":1},
    "verification_scope":{"type":"string","minLength":1},
    "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "independent_verifier":{"type":"string","minLength":1},
    "verification_method":{"type":"string","minLength":1},
    "reviewed_at":{"type":"string","minLength":1},
    "verification_state":{"type":"string","enum":["REGISTERED","UNVERIFIED","REVIEW","VERIFIED","BLOCKED"]},
    "limitations":{"type":"array","items":{"type":"string"}},
    "result_artifact_ref":{"type":"string","minLength":1},
    "result_artifact_sha256":{"type":"string","pattern":"^[0-9a-fA-F]{64}$"}
  },
  "allOf":[
    {
      "if":{"properties":{"verification_state":{"const":"VERIFIED"}}},
      "then":{"required":["result_artifact_ref","result_artifact_sha256"]}
    }
  ],
  "additionalProperties":false
}
