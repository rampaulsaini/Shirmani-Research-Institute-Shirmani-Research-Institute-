{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shirmani Research Factory Concept Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "label",
    "status",
    "relations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "language": {
      "type": "string"
    },
    "definition": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "NORMALIZED",
        "REVIEWED"
      ]
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target"
        ],
        "properties": {
          "type": {
            "enum": [
              "SAME_AS",
              "RELATED_TO",
              "CONTRASTS_WITH",
              "PART_OF",
              "DERIVED_FROM",
              "USED_BY"
            ]
          },
          "target": {
            "type": "string"
          }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
