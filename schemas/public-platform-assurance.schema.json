{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rampaulsaini.github.io/Shirmani-Research-Institute-Shirmani-Research-Institute-/schemas/public-platform-assurance.schema.json",
  "title": "Yatharth Public Platform Assurance Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generated_at", "source_registry", "summary", "checks"],
  "properties": {
    "version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_registry": { "const": "docs/public-platform/public-capability-registry.json" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains", "operational", "architecture_only", "failures"],
      "properties": {
        "domains": { "type": "integer", "minimum": 0 },
        "operational": { "type": "integer", "minimum": 0 },
        "architecture_only": { "type": "integer", "minimum": 0 },
        "failures": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "message"],
        "properties": {
          "id": { "type": "string", "pattern": "^check-[1-9][0-9]*$" },
          "status": { "enum": ["PASS", "FAIL", "WARN"] },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
