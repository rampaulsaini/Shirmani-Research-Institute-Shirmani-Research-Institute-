{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"SHIRMANI Scientific Validation Record",
  "type":"object",
  "required":["record_id","claim_class","hypothesis","operational_definition","dataset","controls","metrics","result","uncertainty","replication","verification_state","provenance"],
  "properties":{
    "record_id":{"type":"string","minLength":1},
    "claim_class":{"type":"string","enum":["OBSERVATION","ASSOCIATION","PREDICTION","CAUSAL","SUBJECTIVE-EXPERIENCE"]},
    "hypothesis":{"type":"string","minLength":1},
    "operational_definition":{"type":"string","minLength":1},
    "dataset":{"type":"object","required":["train_eval_separation","source","test_protection"],"properties":{
      "train_eval_separation":{"const":true},
      "source":{"type":"array","minItems":1,"items":{"type":"string"}},
      "test_protection":{"type":"boolean"}
    }},
    "controls":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "metrics":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "result":{"type":"object","required":["summary","held_out","effect_or_error","uncertainty_interval"],"properties":{
      "summary":{"type":"string","minLength":1},
      "held_out":{"const":true},
      "effect_or_error":{"type":"string","minLength":1},
      "uncertainty_interval":{"type":"string","minLength":1}
    }},
    "uncertainty":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "replication":{"type":"object","required":["independent","status","replication_id"],"properties":{
      "independent":{"type":"boolean"},
      "status":{"type":"string","enum":["NOT_ATTEMPTED","PENDING","FAILED","PARTIAL","SUCCESS"]},
      "replication_id":{"type":"string","minLength":1}
    }},
    "verification_state":{"type":"string","enum":["REGISTERED","UNVERIFIED","REVIEW","VERIFIED","BLOCKED","ABSTAIN"]},
    "verification":{"type":"object","required":["verifier_id","method","artifact_ref","outcome","independence_attestation"],"properties":{
      "verifier_id":{"type":"string","minLength":1},
      "method":{"type":"string","minLength":1},
      "artifact_ref":{"type":"string","minLength":1},
      "outcome":{"type":"string","enum":["PASS","FAIL","INCONCLUSIVE"]},
      "independence_attestation":{"type":"boolean"}
    }},
    "provenance":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
  },
  "allOf":[{
    "if":{"properties":{"verification_state":{"const":"VERIFIED"}},"required":["verification_state"]},
    "then":{"required":["verification"],"properties":{
      "dataset":{"properties":{"train_eval_separation":{"const":true},"test_protection":{"const":true}}},
      "replication":{"properties":{"independent":{"const":true},"status":{"const":"SUCCESS"}}},
      "result":{"properties":{"held_out":{"const":true}}},
      "verification":{"properties":{"outcome":{"const":"PASS"},"independence_attestation":{"const":true}}}
    }}
  }]
}