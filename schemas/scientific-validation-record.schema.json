{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SHIRMANI Scientific Validation Record",
  "type": "object",
  "required": ["record_id","claim_class","hypothesis","operational_definition","dataset","controls","metrics","result","uncertainty","replication","verification_state","provenance"],
  "properties": {
    "record_id": {"type":"string","minLength":1},
    "claim_class": {"type":"string","enum":["OBSERVATION","ASSOCIATION","PREDICTION","CAUSAL","SUBJECTIVE-EXPERIENCE"]},
    "hypothesis": {"type":"string","minLength":1},
    "operational_definition": {"type":"string","minLength":1},
    "dataset": {"type":"object","required":["train_eval_separation","source"],"properties":{"train_eval_separation":{"type":"boolean"},"source":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "controls": {"type":"array","minItems":1,"items":{"type":"string"}},
    "metrics": {"type":"array","minItems":1,"items":{"type":"string"}},
    "result": {"type":"object","required":["summary","held_out"],"properties":{"summary":{"type":"string","minLength":1},"held_out":{"type":"boolean"}}},
    "uncertainty": {"type":"array","minItems":1,"items":{"type":"string"}},
    "replication": {"type":"object","required":["independent","status"],"properties":{"independent":{"type":"boolean"},"status":{"type":"string","enum":["NOT_ATTEMPTED","PENDING","FAILED","PARTIAL","SUCCESS"]}}},
    "verification_state": {"type":"string","enum":["REGISTERED","UNVERIFIED","REVIEW","VERIFIED","BLOCKED","ABSTAIN"]},
    "provenance": {"type":"array","minItems":1,"items":{"type":"string"}}
  }
}
