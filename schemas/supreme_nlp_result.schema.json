{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Supreme NLP Result",
  "type": "object",
  "required": [
    "run_id",
    "observations",
    "interpretations",
    "verification"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "interpretations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "confidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNVERIFIED",
            "PARTIALLY_VERIFIED",
            "VERIFIED",
            "REJECTED"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "checks_passed": {
          "type": "integer",
          "minimum": 0
        },
        "checks_failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "model_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "explanation": {
      "type": "string"
    }
  }
}
