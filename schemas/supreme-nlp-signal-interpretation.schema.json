{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"SHIRMANI Supreme NLP Signal Interpretation",
  "type":"object",
  "required":["record_id","modality","measured_signal","detected_pattern","model_inference","plain_language","uncertainty","provenance","verification_state"],
  "properties":{
    "record_id":{"type":"string","minLength":1},
    "modality":{"type":"string","minLength":1},
    "measured_signal":{"type":"string","minLength":1},
    "detected_pattern":{"type":"string","minLength":1},
    "model_inference":{"type":"string","minLength":1},
    "plain_language":{"type":"string","minLength":1},
    "uncertainty":{"type":"string","minLength":1},
    "provenance":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "alternative_interpretations":{"type":"array","items":{"type":"string"}},
    "unresolved_unknowns":{"type":"array","items":{"type":"string"}},
    "verification_state":{"type":"string","enum":["REGISTERED","UNVERIFIED","REVIEW","VERIFIED","BLOCKED"]}
  },
  "additionalProperties":false
}
