{
  "schema_version": "1.0",
  "record_type": "automission_quality_cycle",
  "required": [
    "cycle_id",
    "timestamp",
    "input_provenance",
    "agent_versions",
    "verification_status",
    "uncertainty",
    "tests",
    "audit"
  ],
  "verification_status_enum": [
    "READY",
    "CHECK",
    "PASS",
    "VERIFIED",
    "NOT_VERIFIED",
    "UNAVAILABLE"
  ],
  "integrity_rules": [
    "generated_output_is_not_ground_truth",
    "verification_must_be_independent",
    "uncertainty_must_be_preserved",
    "failed_verification_cannot_be_promoted_to_verified"
  ]
}