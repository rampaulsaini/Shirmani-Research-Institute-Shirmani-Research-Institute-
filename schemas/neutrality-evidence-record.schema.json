{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SHIRMANI Neutrality Evidence Record",
  "type": "object",
  "required": ["schema_version","claim_id","claim_state","evidence","counter_evidence","provenance","verification"],
  "properties": {
    "schema_version": {"const": "neutrality-evidence-v1"},
    "claim_id": {"type": "string", "minLength": 1},
    "claim_state": {"enum": ["OBSERVED","INTERPRETED","HYPOTHESIS","EVIDENCE-SUPPORTED","INDEPENDENTLY-VERIFIED","BLOCKED","REQUIRES_REVIEW"]},
    "evidence": {"type": "array"},
    "counter_evidence": {"type": "array"},
    "provenance": {"type": "object","required": ["source","model_version"]},
    "uncertainty": {"type": ["object","null"],"properties": {"confidence": {"type":"number","minimum":0,"maximum":1},"calibration_status": {"enum":["UNCALIBRATED","CALIBRATED","CALIBRATION_FAILED"]}}},
    "verification": {"type":"object","required":["independent_required","status"],"properties":{"independent_required":{"const":true},"status":{"enum":["UNVERIFIED","UNDER_REVIEW","VERIFIED","BLOCKED"]},"reviewer_role":{"type":["string","null"]}}}
  }
}
