{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rampaulsaini.github.io/Shirmani-Research-Institute-Shirmani-Research-Institute-/schemas/impartial-understanding-parameter.schema.json",
  "title": "SHIRMANI Impartial Understanding Parameter",
  "description": "Auditable response-review record. Not a validated measurement of consciousness, spirituality, impartiality, or personal worth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "perspective_label",
    "evidence_state",
    "evidence_refs",
    "counterview_checked",
    "uncertainty_note",
    "harm_and_stakeholder_check",
    "self_review_result",
    "audit_timestamp",
    "model_version"
  ],
  "properties": {
    "perspective_label": {
      "type": "string",
      "minLength": 1,
      "description": "Named lens, e.g. neutral, user-philosophy, stakeholder."
    },
    "evidence_state": {
      "type": "string",
      "enum": ["VERIFIED", "SOURCE_BASED", "PHILOSOPHICAL_IDENTITY", "INSUFFICIENT_EVIDENCE"]
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "uniqueItems": true
    },
    "counterview_checked": { "type": "boolean" },
    "uncertainty_note": { "type": "string" },
    "harm_and_stakeholder_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "notes"],
      "properties": {
        "checked": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "self_review_result": {
      "type": "string",
      "enum": ["pass", "revise", "insufficient-evidence"]
    },
    "audit_timestamp": { "type": "string", "format": "date-time" },
    "model_version": { "type": "string", "minLength": 1 },
    "user_defined_philosophical_aspiration": {
      "type": "object",
      "description": "Optional user-defined framing only; never treat as measured or scientifically validated.",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "heart_view_percent": { "const": 99.9999 },
        "mind_intellect_view_percent": { "const": 0.0001 },
        "status": { "const": "PHILOSOPHICAL_ASPIRATION_NOT_MEASURED" }
      },
      "required": ["label", "heart_view_percent", "mind_intellect_view_percent", "status"]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "evidence_state": { "const": "VERIFIED" } }, "required": ["evidence_state"] },
      "then": {
        "properties": {
          "evidence_refs": { "minItems": 1 },
          "uncertainty_note": { "minLength": 1 }
        }
      }
    },
    {
      "if": { "properties": { "evidence_state": { "const": "INSUFFICIENT_EVIDENCE" } }, "required": ["evidence_state"] },
      "then": {
        "properties": {
          "self_review_result": { "enum": ["revise", "insufficient-evidence"] }
        }
      }
    }
  ]
}
