{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SHIRMANI Supreme Multimodal Signal Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id","timestamp","modality","signal_fingerprint","preprocessing",
    "features","pattern","model","inference","confidence","provenance",
    "alternatives","unknowns","verification_state"
  ],
  "properties": {
    "source_id": {"type":"string","minLength":1},
    "timestamp": {"type":"string","minLength":1},
    "modality": {"type":"string","enum":["text","speech","image","video","environmental","iot","acoustic","vibration","thermal","electrical","chemical","biological","plant","multimodal"]},
    "signal_fingerprint": {"type":"string","minLength":8},
    "preprocessing": {"type":"string","minLength":1},
    "features": {"type":"array","items":{"type":"string"}},
    "pattern": {"type":"string","minLength":1},
    "model": {"type":"object","additionalProperties":false,"required":["name","version"],"properties":{"name":{"type":"string","minLength":1},"version":{"type":"string","minLength":1}}},
    "inference": {"type":"string","minLength":1},
    "confidence": {"type":"object","additionalProperties":false,"required":["value","method"],"properties":{"value":{"type":"number","minimum":0,"maximum":1},"method":{"type":"string","minLength":1}}},
    "provenance": {"type":"array","minItems":1,"items":{"type":"string"}},
    "alternatives": {"type":"array","items":{"type":"string"}},
    "unknowns": {"type":"array","items":{"type":"string"}},
    "verification_state": {"type":"string","enum":["REGISTERED","UNVERIFIED","REVIEW","VERIFIED","BLOCKED"]}
  }
}
