{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shirmani Research Factory Verification Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "verification_status",
    "checks"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "verification_status": {
      "enum": [
        "PASS",
        "PARTIAL",
        "FAIL",
        "NOT_VERIFIED"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "details"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIPPED",
              "NOT_VERIFIED"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string"
    }
  }
}
