{
  "schema_version": "1.1",
  "name": "shirmani-ai-agent-governance",
  "foundation": "nishpaksh-samajh",
  "neutrality_contract": {
    "enabled": true,
    "definition": "Equal treatment of persons, claims, sources and hypotheses; no identity, ideology, status or prior belief is used as evidence.",
    "claim_statuses": ["OBSERVED", "INFERRED", "ATTRIBUTED", "UNVERIFIED", "VERIFIED", "BLOCKED"],
    "counter_evidence_required": true,
    "uncertainty_required": true,
    "source_provenance_required": true
  },
  "truth_boundary": "framework_proposition_not_silent_empirical_fact",
  "authorization": {
    "irreversible_actions": "owner_authorization_required",
    "financial_actions": "explicit_integration_and_authorization_required",
    "verification_promotion": "independent_verification_required"
  },
  "default_status": "UNVERIFIED",
  "fail_closed": true,
  "provenance_required_for_claims": true,
  "fabrication_prohibited": true,
  "secret_handling": "secret_store_only",
  "public_surface_may_expose_secrets": false,
  "agent_layers": ["intake_source","reasoning","evidence","counter_evidence","verification","product","marketing","economic_transaction","security_audit","publishing","continuity"]
}
