{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SHIRMANI Ultra Mega Infinity Quantum AI ML NLP Automission Cycle",
  "type": "object",
  "required": [
    "cycle_id",
    "timestamp",
    "architecture",
    "stages",
    "verification_state",
    "provenance",
    "blockers",
    "metrics",
    "gates"
  ],
  "properties": {
    "cycle_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "minLength": 1},
    "architecture": {"type": "string", "const": "ultra-mega-infinity-quantum"},
    "stages": {"type": "array", "minItems": 8, "items": {"type": "string"}},
    "verification_state": {
      "type": "string",
      "enum": ["REGISTERED", "UNVERIFIED", "REVIEW", "VERIFIED", "BLOCKED"]
    },
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "metrics": {"type": "object", "additionalProperties": {"type": "number"}},
    "input_fingerprint": {"type": ["string", "null"], "minLength": 1},
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["exit_code", "output"],
        "properties": {
          "exit_code": {"type": ["integer", "null"]},
          "output": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
