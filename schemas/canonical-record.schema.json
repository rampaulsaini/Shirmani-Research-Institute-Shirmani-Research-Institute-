{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rampaulsaini.github.io/Shirmani-Research-Institute-Shirmani-Research-Institute-/schemas/canonical-record.schema.json",
  "title": "Shirmani Canonical Record",
  "description": "Evidence-first canonical record contract. A canonical record preserves source provenance before downstream reasoning or publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "record_type",
    "source",
    "content",
    "evidence_state",
    "verification_state",
    "provenance"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "record_type": {
      "type": "string",
      "enum": ["source", "unit", "concept", "claim", "evidence", "formulation", "artifact"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "published_at": { "type": ["string", "null"] }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_text"],
      "properties": {
        "exact_text": { "type": "string" },
        "language": { "type": "string", "minLength": 2 },
        "content_hash": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim_type": {
          "type": ["string", "null"],
          "enum": ["descriptive", "interpretive", "framework", "empirical", "normative", "unknown", null]
        },
        "framework_terms": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "evidence_state": {
      "type": "string",
      "enum": ["READY", "REGISTERED", "MISSING", "SOURCE_ONLY", "CHECK", "UNAVAILABLE", "NOT_VERIFIED", "DEFERRED"]
    },
    "verification_state": {
      "type": "string",
      "enum": ["PASS", "CHECK", "NOT_VERIFIED", "UNAVAILABLE", "DEFERRED"]
    },
    "uncertainty": {
      "type": ["string", "null"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured_at", "method"],
      "properties": {
        "captured_at": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "parent_record_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "derivative_of": {
          "type": ["string", "null"]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "independent_check": { "type": "boolean" },
        "checker": { "type": ["string", "null"] },
        "checked_at": { "type": ["string", "null"] }
      }
    },
    "artifact_links": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
