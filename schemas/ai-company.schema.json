{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["version","companies"],
  "properties":{
    "version":{"type":"integer"},
    "companies":{"type":"array","items":{
      "type":"object",
      "required":["id","name","skills"],
      "properties":{
        "id":{"type":"string"},
        "name":{"type":"string"},
        "skills":{"type":"array","items":{"type":"string"}}
      }
    }}
  }
}