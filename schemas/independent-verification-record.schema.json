{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Shirmani Independent Verification Record",
  "type":"object",
  "required":["id","claim","operational_definition","evidence","independent_test","reproducibility","counter_evidence","audit","reviewer_decision"],
  "properties":{
    "id":{"type":"string","pattern":"^IV-[0-9]{3,}$"},
    "claim":{"type":"string","minLength":1},
    "operational_definition":{"type":"string","minLength":1},
    "evidence":{"type":"object","required":["sources","evidence_hash"],"properties":{"sources":{"type":"array","items":{"type":"string"}},"evidence_hash":{"type":"string","minLength":16}}},
    "independent_test":{"type":"object","required":["protocol","result","test_hash"],"properties":{"protocol":{"type":"string"},"result":{"type":"string"},"test_hash":{"type":"string","minLength":16}}},
    "reproducibility":{"type":"object","required":["environment","reproduction_steps","result_match"],"properties":{"environment":{"type":"string"},"reproduction_steps":{"type":"array","minItems":1,"items":{"type":"string"}},"result_match":{"type":"boolean"}}},
    "counter_evidence":{"type":"object","required":["reviewed","summary"],"properties":{"reviewed":{"type":"boolean"},"summary":{"type":"string"}}},
    "audit":{"type":"object","required":["audit_id","passed","timestamp"],"properties":{"audit_id":{"type":"string"},"passed":{"type":"boolean"},"timestamp":{"type":"string"}}},
    "reviewer_decision":{"type":"object","required":["decision"],"properties":{"decision":{"type":"string","enum":["PENDING","VERIFIED","NOT_VERIFIED","CONTRADICTED"]},"reviewer_identity":{"type":"string"},"reviewer_role":{"type":"string"},"timestamp":{"type":"string"}}}
  }
}
