{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://rampaulsaini.github.io/Shirmani-Research-Institute-Shirmani-Research-Institute-/schemas/supreme-nlp-observation-v2.schema.json",
  "title":"Supreme NLP Multimodal Observation v2",
  "type":"object","additionalProperties":false,
  "required":["observation_id","subject_class","modality","feature","value","quality","source","observed_at"],
  "properties":{
    "observation_id":{"type":"string","minLength":1},
    "subject_class":{"type":"string","enum":["human","animal","plant","environment","machine","non_living","synthetic"]},
    "modality":{"type":"string","minLength":1},"feature":{"type":"string","minLength":1},
    "value":{"type":"number"},"unit":{"type":"string"},
    "quality":{"type":"number","minimum":0,"maximum":1},"source":{"type":"string","minLength":1},
    "observed_at":{"type":"string","format":"date-time"},"calibration_ref":{"type":"string"},
    "evidence_ref":{"type":"string"},"counter_evidence_ref":{"type":"string"},
    "label":{"type":"string"},"label_confidence":{"type":"number","minimum":0,"maximum":1}
  }
}