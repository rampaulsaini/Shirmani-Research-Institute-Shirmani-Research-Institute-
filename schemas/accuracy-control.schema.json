{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shirmani Deterministic Accuracy Control",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "fail_closed",
    "records_scanned",
    "publication_decision",
    "important_boundary"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "mode": {"const": "deterministic-accuracy-control"},
    "fail_closed": {"const": true},
    "records_scanned": {"type": "integer", "minimum": 0},
    "verified_records_observed": {"type": "integer", "minimum": 0},
    "duplicate_groups": {"type": "integer", "minimum": 0},
    "quality_signal_mean_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "publication_decision": {"enum": ["PASS", "CHECK", "NO_DATA"]},
    "important_boundary": {"type": "string"}
  }
}
