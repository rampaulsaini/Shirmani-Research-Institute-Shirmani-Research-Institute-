{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Derivative Link",
  "type": "object",
  "additionalProperties": false,
  "required": ["derivative_id", "source_ids", "derivative_type"],
  "properties": {
    "derivative_id": {"type": "string"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "derivative_type": {"enum": ["translation", "normalization", "summary", "interpretation", "code", "research_formulation", "publication"]},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["DRAFT", "REVIEW", "PUBLISHED"]}
  }
}