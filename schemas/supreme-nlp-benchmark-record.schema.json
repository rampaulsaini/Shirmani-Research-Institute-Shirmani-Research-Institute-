{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"SHIRMANI Supreme NLP Benchmark Record",
  "type":"object",
  "required":["record_id","task","population_scope","dataset_fingerprint","model","metric","direction","baseline","candidate","delta","uncertainty","provenance","limitations","verification_state"],
  "properties":{
    "record_id":{"type":"string","minLength":1},
    "task":{"type":"string","minLength":1},
    "population_scope":{"type":"string","minLength":1},
    "dataset_fingerprint":{"type":"string","minLength":1},
    "model":{"type":"object","required":["name","version"],"properties":{"name":{"type":"string","minLength":1},"version":{"type":"string","minLength":1}},"additionalProperties":false},
    "metric":{"type":"string","minLength":1},
    "direction":{"type":"string","enum":["higher_is_better","lower_is_better"]},
    "baseline":{"type":"number"},
    "candidate":{"type":"number"},
    "delta":{"type":"number"},
    "uncertainty":{"type":"string","minLength":1},
    "provenance":{"type":"array","minItems":1,"items":{"type":"string"}},
    "limitations":{"type":"array","items":{"type":"string"}},
    "verification_state":{"type":"string","enum":["REGISTERED","UNVERIFIED","REVIEW","VERIFIED","BLOCKED","PROPOSED_IMPROVEMENT"]}
  },
  "additionalProperties":false
}
