{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rampaulsaini.github.io/Shirmani-Research-Institute-Shirmani-Research-Institute-/schemas/multimodal-signal-record.schema.json",
  "title": "Multimodal Signal Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "timestamp", "modality", "source", "signal", "provenance", "inference"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "modality": {
      "type": "string",
      "enum": ["text", "audio", "image", "video", "sensor", "vibration", "electrical", "biophysical", "environmental", "temporal"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_type": {"type": "string", "minLength": 1}
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation"],
      "properties": {
        "representation": {"type": "string", "minLength": 1},
        "quality": {"type": "number", "minimum": 0, "maximum": 1},
        "units": {"type": ["string", "null"]},
        "baseline_reference": {"type": ["string", "null"]}
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "confidence", "status"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"type": "string", "enum": ["observed", "inferred", "uncertain", "abstained", "verified"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline_version"],
      "properties": {
        "pipeline_version": {"type": "string", "minLength": 1},
        "model_version": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "independent_check": {"type": "boolean"},
        "verification_notes": {"type": "string"}
      }
    }
  }
}
