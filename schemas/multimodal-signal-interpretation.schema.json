{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shirmani Multimodal Signal Interpretation Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","record_id","source","signals","interpretation","uncertainty","verification"],
  "properties": {
    "schema_version": {"type":"string","const":"1.0"},
    "record_id": {"type":"string","minLength":1},
    "source": {"type":"object","additionalProperties":false,"required":["source_type","provenance"],"properties":{"source_type":{"type":"string","enum":["text","audio","image","video","sensor","bioelectric","environmental","other"]},"provenance":{"type":"string","minLength":1}}},
    "signals": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name","value","unit"],"properties":{"name":{"type":"string"},"value":{},"unit":{"type":"string"},"quality":{"type":"number","minimum":0,"maximum":1}}}},
    "interpretation": {"type":"object","additionalProperties":false,"required":["plain_language","classification_type"],"properties":{"plain_language":{"type":"string"},"classification_type":{"type":"string","enum":["measured","model_inference","interpretation","hypothesis"]},"model":{"type":["string","null"]},"model_version":{"type":["string","null"]}}},
    "uncertainty": {"type":"object","additionalProperties":false,"required":["confidence","limitations"],"properties":{"confidence":{"type":"number","minimum":0,"maximum":1},"limitations":{"type":"array","items":{"type":"string"}}}},
    "verification": {"type":"object","additionalProperties":false,"required":["status","independent"],"properties":{"status":{"type":"string","enum":["UNVERIFIED","PARTIALLY_VERIFIED","INDEPENDENTLY_VERIFIED","REJECTED"]},"independent":{"type":"boolean"},"evidence_ids":{"type":"array","items":{"type":"string"}}}}
  }
}