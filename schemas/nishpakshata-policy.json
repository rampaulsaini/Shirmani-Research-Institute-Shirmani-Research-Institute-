{
  "schema_version": "1.0",
  "name": "shirmani-nishpakshata-supreme-gate",
  "purpose": "Machine-checkable impartiality contract for AI agents and Automission.",
  "foundation": "nishpaksh-samajh",
  "default_status": "unverified",
  "fail_closed": true,
  "principles": {
    "evidence_before_assertion": true,
    "source_provenance_required": true,
    "counter_evidence_required_for_contested_claims": true,
    "uncertainty_must_be_explicit": true,
    "author_framework_must_be_distinguished_from_empirical_fact": true,
    "identity_must_not_control_truth_status": true,
    "authority_must_not_control_truth_status": true,
    "popularity_must_not_control_truth_status": true,
    "user_preference_must_not_control_truth_status": true,
    "no_unsupported_ranking_or_winner_claims": true
  },
  "classification": [
    "AUTHOR-DEFINED",
    "AUTHOR-PROPOSED",
    "EMPIRICAL-TESTABLE",
    "EVIDENCE-SUPPORTED",
    "NOT_VERIFIED",
    "CONTRADICTED"
  ],
  "required_claim_fields": [
    "claim_id",
    "claim_text",
    "classification",
    "provenance",
    "evidence",
    "uncertainty"
  ],
  "verification_promotion": {
    "required": true,
    "independent_source_or_reproducible_test": true,
    "counter_evidence_review": true,
    "reviewer_identity_or_role": true,
    "timestamp": true,
    "explicit_decision": true
  },
  "blocked_shortcuts": [
    "personal_identity_as_evidence",
    "authority_as_evidence",
    "majority_as_evidence",
    "repetition_as_evidence",
    "model_confidence_as_proof",
    "workflow_success_as_verification",
    "unverified_framework_claim_as_empirical_fact"
  ]
}
