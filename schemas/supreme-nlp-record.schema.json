{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Supreme NLP Record",
  "type":"object",
  "required":["schema_version","task_id","generated_at","pipeline","provenance","uncertainty","result","simple_language","fingerprint"],
  "properties":{
    "schema_version":{"const":"1.2"},
    "task_id":{"type":"string","minLength":1},
    "generated_at":{"type":"string","minLength":1},
    "pipeline":{"type":"string","minLength":1},
    "provenance":{
      "type":"object",
      "required":["input_contract","source_count","generated_by"],
      "properties":{
        "input_contract":{"type":"string","minLength":1},
        "source_count":{"type":"integer","minimum":0},
        "generated_by":{"type":"string","minLength":1}
      }
    },
    "uncertainty":{
      "type":"object",
      "required":["confidence_is_calibrated","independent_verification","causal_claim"],
      "properties":{
        "confidence_is_calibrated":{"const":false},
        "independent_verification":{"enum":["NOT_VERIFIED","VERIFIED"]},
        "causal_claim":{"enum":["NOT_ESTABLISHED","SUPPORTED"]}
      }
    },
    "simple_language":{"type":"string","minLength":1},
    "fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "result":{
      "type":"object",
      "required":["status","signals","quality_diagnostics","rejected_inputs"],
      "properties":{
        "status":{"enum":["no_data","insufficient_quality","interpreted"]},
        "signals":{"type":"array"},
        "rejected_inputs":{"type":"array","items":{"type":"string"}},
        "quality_diagnostics":{
          "type":"object",
          "required":["input_count","usable_count","dropped_count","mean_quality"],
          "properties":{
            "input_count":{"type":"integer","minimum":0},
            "usable_count":{"type":"integer","minimum":0},
            "dropped_count":{"type":"integer","minimum":0},
            "mean_quality":{"type":"number","minimum":0,"maximum":1}
          }
        },
        "features":{
          "type":"object",
          "required":["mean","spread","anomaly_score","agreement","quality","modalities","evidence_grade"],
          "properties":{
            "mean":{"type":"number"},
            "spread":{"type":"number","minimum":0},
            "anomaly_score":{"type":"number","minimum":0,"maximum":1},
            "agreement":{"type":"number","minimum":0,"maximum":1},
            "quality":{"type":"number","minimum":0,"maximum":1},
            "modalities":{"type":"integer","minimum":0},
            "evidence_grade":{"enum":["A","B","C","D"]}
          }
        },
        "interpretation":{
          "type":["object","null"],
          "properties":{
            "state":{"type":"string"},
            "confidence":{"type":"number","minimum":0,"maximum":0.95},
            "evidence":{"type":"array"},
            "limitations":{"type":"array","items":{"type":"string"}}
          }
        }
      }
    }
  }
}
