{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Supreme NLP Multimodal Record",
  "type":"object",
  "required":["event_id","source_type","observations","interpretation","confidence","evidence","verification","provenance"],
  "properties":{
    "event_id":{"type":"string","minLength":1},
    "source_type":{"type":"string","minLength":1},
    "observations":{"type":"array","minItems":1},
    "interpretation":{"type":"object"},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "evidence":{"type":"array"},
    "verification":{"type":"object","required":["independent_check"],"properties":{"independent_check":{"type":"boolean"},"method":{"type":"string"}}},
    "provenance":{"type":"object"}
  },
  "additionalProperties":true
}
