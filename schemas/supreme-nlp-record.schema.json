{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Supreme NLP Record",
  "type":"object",
  "required":["schema_version","task_id","generated_at","pipeline","result","simple_language","fingerprint","provenance","governance"],
  "properties":{
    "schema_version":{"const":"supreme-nlp-v2"},
    "task_id":{"type":"string","minLength":1},
    "generated_at":{"type":"string","minLength":1},
    "pipeline":{"type":"string","minLength":1},
    "simple_language":{"type":"string","minLength":1},
    "fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "provenance":{"type":"object","required":["generator","contract","verification_status"]},
    "governance":{
      "type":"object",
      "required":["impartiality_contract_version","evidence_first","identity_neutral_evaluation","uncertainty_explicit","counterevidence_required_for_strong_claims","no_person_or_group_preference","independent_verification_required","accuracy_is_measured_not_declared","fail_closed","scheduled_code_mutation_allowed","subjective_experience_claim_allowed"],
      "properties":{
        "impartiality_contract_version":{"const":"impartiality-v1"},
        "evidence_first":{"const":true},
        "identity_neutral_evaluation":{"const":true},
        "uncertainty_explicit":{"const":true},
        "counterevidence_required_for_strong_claims":{"const":true},
        "no_person_or_group_preference":{"const":true},
        "independent_verification_required":{"const":true},
        "accuracy_is_measured_not_declared":{"const":true},
        "fail_closed":{"const":true},
        "scheduled_code_mutation_allowed":{"const":false},
        "subjective_experience_claim_allowed":{"const":false}
      }
    },
    "result":{
      "type":"object",
      "required":["status","signals"],
      "properties":{
        "status":{"enum":["no_data","insufficient_quality","interpreted"]},
        "signals":{"type":"array"},
        "features":{
          "type":"object",
          "required":["mean","spread","anomaly_score","agreement","quality","modalities","independent_sources","sample_count","drift_score","evidence_grade"],
          "properties":{
            "mean":{"type":"number"},"spread":{"type":"number"},
            "anomaly_score":{"type":"number","minimum":0,"maximum":1},
            "agreement":{"type":"number","minimum":0,"maximum":1},
            "quality":{"type":"number","minimum":0,"maximum":1},
            "modalities":{"type":"integer","minimum":0},
            "independent_sources":{"type":"integer","minimum":0},
            "sample_count":{"type":"integer","minimum":0},
            "drift_score":{"type":"number","minimum":0,"maximum":1},
            "evidence_grade":{"enum":["A","B","C","D"]}
          }
        },
        "interpretation":{
          "type":["object","null"],
          "properties":{
            "state":{"type":"string"},
            "confidence":{"type":"number","minimum":0,"maximum":1},
            "confidence_status":{"const":"UNCALIBRATED"},
            "evidence":{"type":"array","items":{"type":"string"}},
            "limitations":{"type":"array","items":{"type":"string"}}
          }
        },
        "verification":{
          "type":"object",
          "required":["status","independent_required","replication_required"]
        }
      }
    }
  }
}
