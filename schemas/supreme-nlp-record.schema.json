{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Supreme NLP Multimodal Record",
  "type": "object",
  "required": [
    "event_id",
    "source_type",
    "observations",
    "interpretation",
    "confidence",
    "evidence",
    "verification",
    "provenance"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    },
    "interpretation": {
      "type": "object",
      "required": ["plain_language", "claim_type"],
      "properties": {
        "plain_language": {"type": "string", "minLength": 1},
        "claim_type": {
          "type": "string",
          "enum": ["observation", "data_interpretation", "hypothesis", "scientific_claim"]
        }
      },
      "additionalProperties": true
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "verification": {
      "type": "object",
      "required": ["independent_check"],
      "properties": {
        "independent_check": {"type": "boolean"},
        "method": {"type": "string"},
        "independent_evaluator_count": {"type": "integer", "minimum": 0},
        "confidence_calibrated": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "minProperties": 1
    }
  },
  "additionalProperties": false
}
