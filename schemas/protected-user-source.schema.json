{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protected User Source Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "exact_text", "language", "captured_at", "content_hash", "provenance"],
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "exact_text": {"type": "string"},
    "language": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "parent_context": {"type": ["string", "null"]},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "locator"],
      "properties": {
        "source_kind": {"enum": ["conversation", "file", "repository", "user_submission", "other"]},
        "locator": {"type": "string", "minLength": 1},
        "repository": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "commit": {"type": ["string", "null"]}
      }
    },
    "derivative_links": {"type": "array", "items": {"type": "string"}},
    "preservation_status": {"enum": ["CAPTURED", "HASHED", "VERIFIED", "MISSING_SOURCE"]}
  }
}