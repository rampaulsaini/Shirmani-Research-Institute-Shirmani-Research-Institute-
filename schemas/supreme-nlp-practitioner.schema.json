{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Supreme NLP Practitioner Record",
  "type":"object",
  "required":["schema_version","generated_at","pipeline","result","simple_language","fingerprint","governance"],
  "properties":{
    "schema_version":{"enum":["1.0","1.1"]},
    "generated_at":{"type":"string","minLength":1},
    "pipeline":{"type":"string","minLength":1},
    "simple_language":{"type":"string","minLength":1},
    "fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "result":{"type":"object","required":["status"],
      "properties":{
        "status":{"enum":["insufficient_quality","interpreted"]},
        "language":{"type":"string"},"intent":{"type":"string"},
        "features":{"type":"object","required":["confidence","confidence_type","agreement","quality","modalities","sources","groups","contradiction_detected"],
          "properties":{
            "confidence":{"type":"number","minimum":0,"maximum":1},
            "confidence_type":{"const":"heuristic_uncalibrated"},
            "agreement":{"type":"number","minimum":0,"maximum":1},
            "quality":{"type":"number","minimum":0,"maximum":1},
            "modalities":{"type":"integer","minimum":0},
            "sources":{"type":"integer","minimum":0},
            "groups":{"type":"integer","minimum":0},
            "contradiction_detected":{"type":"boolean"}
          }
        }
      }
    },
    "governance":{"type":"object","required":["fail_closed","subjective_experience_claim_allowed","code_mutation_allowed","independent_verification_required"],
      "properties":{
        "fail_closed":{"const":true},
        "subjective_experience_claim_allowed":{"const":false},
        "code_mutation_allowed":{"const":false},
        "independent_verification_required":{"const":true}
      }
    }
  }
}