{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Multimodal Signal NLP Record",
  "type":"object",
  "required":["record_id","source_type","observations","interpretation","confidence","uncertainty","provenance","verification_status"],
  "properties":{
    "record_id":{"type":"string","minLength":1},
    "source_type":{"type":"string","enum":["living","plant","environment","non_living","synthetic"]},
    "observations":{"type":"array","items":{"type":"object","required":["channel","value"],"properties":{"channel":{"type":"string"},"value":{}}}},
    "interpretation":{"type":"string"},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "uncertainty":{"type":"array","items":{"type":"string"}},
    "provenance":{"type":"object","required":["method","input_hash"],"properties":{"method":{"type":"string"},"input_hash":{"type":"string"}}},
    "verification_status":{"type":"string","enum":["NOT_VERIFIED","VERIFIED"]},
    "subjective_feeling_claim":{"type":"boolean"}
  },
  "additionalProperties":true
}
