{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shirmani Research Factory Source Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_type",
    "title",
    "locator",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "source_type": {
      "enum": [
        "BOOK",
        "SCRIPTURE",
        "PAPER",
        "DATASET",
        "WEBSITE",
        "REPOSITORY",
        "ARCHIVE",
        "VIDEO",
        "AUDIO",
        "ORAL_RECORD",
        "OTHER"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded_at"
      ],
      "properties": {
        "recorded_at": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      }
    },
    "availability": {
      "enum": [
        "AVAILABLE",
        "PARTIAL",
        "UNAVAILABLE",
        "RESTRICTED"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
