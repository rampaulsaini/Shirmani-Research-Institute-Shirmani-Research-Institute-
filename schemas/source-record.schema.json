{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Source Record",
  "type":"object",
  "required":["id","source_type","title","locator","provenance"],
  "properties":{
    "id":{"type":"string"},
    "source_type":{"enum":["BOOK","SCRIPTURE","PAPER","DATASET","WEBSITE","REPOSITORY","ARCHIVE","VIDEO","AUDIO","ORAL_RECORD","OTHER"]},
    "title":{"type":"string"},
    "author":{"type":"string"},
    "language":{"type":"string"},
    "date":{"type":"string"},
    "locator":{"type":"string"},
    "content_hash":{"type":"string"},
    "availability":{"enum":["REGISTERED","AVAILABLE","PARTIAL","UNAVAILABLE","RESTRICTED"]},
    "provenance":{"type":"object","required":["recorded_at"],"properties":{
      "recorded_at":{"type":"string"},"repository":{"type":"string"},"path":{"type":["string","null"]},"commit":{"type":["string","null"]}
    }}
  }
}