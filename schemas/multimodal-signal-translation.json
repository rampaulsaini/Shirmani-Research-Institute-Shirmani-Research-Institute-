{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shirmani Multimodal Signal to NLP Contract",
  "schema_version": "1.0",
  "description": "Evidence-first contract for translating observable multimodal signals into human-readable language.",
  "type": "object",
  "required": ["id", "modality", "observation", "features", "interpretation", "uncertainty", "provenance", "verification"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "modality": {"type": "array", "minItems": 1, "items": {"enum": ["text", "audio", "image", "video", "vibration", "electrical", "thermal", "chemical", "motion", "environmental", "other"]}},
    "observation": {"type": "string", "minLength": 1},
    "features": {"type": "array", "items": {"type": "string"}},
    "interpretation": {
      "type": "object", "required": ["label", "basis", "status"],
      "properties": {
        "label": {"type": "string"}, "basis": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["OBSERVED", "INFERRED", "HYPOTHESIS", "UNAVAILABLE"]}
      }, "additionalProperties": false
    },
    "uncertainty": {
      "type": "object", "required": ["level"],
      "properties": {
        "level": {"enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }, "additionalProperties": false
    },
    "provenance": {
      "type": "object", "required": ["created_at", "generator"],
      "properties": {"created_at": {"type": "string"}, "generator": {"type": "string"}, "source": {"type": "string"}, "source_hash": {"type": "string"}},
      "additionalProperties": false
    },
    "verification": {
      "type": "object", "required": ["status"],
      "properties": {"status": {"enum": ["PASS", "CHECK", "FAIL", "NOT_VERIFIED"]}, "independent": {"type": "boolean"}, "method": {"type": "string"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}