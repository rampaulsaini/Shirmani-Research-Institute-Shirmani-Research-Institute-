{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"SHIRMANI Independent Scientific Verification Record",
  "type":"object",
  "required":["verification_id","claim_id","claim_type","candidate_system","verifier_identity","independence_statement","evidence_refs","method","dataset_or_material_fingerprint","analysis_fingerprint","replication_status","result","limitations","verification_state"],
  "properties":{
    "verification_id":{"type":"string","minLength":1},
    "claim_id":{"type":"string","minLength":1},
    "claim_type":{"type":"string","enum":["empirical","computational","interpretive","philosophical"]},
    "candidate_system":{"type":"object","required":["name","version"],"properties":{"name":{"type":"string"},"version":{"type":"string"}},"additionalProperties":false},
    "verifier_identity":{"type":"object","required":["name","role"],"properties":{"name":{"type":"string"},"role":{"type":"string"}},"additionalProperties":false},
    "independence_statement":{"type":"string","minLength":20},
    "evidence_refs":{"type":"array","minItems":2,"items":{"type":"string","minLength":1}},
    "method":{"type":"string","minLength":20},
    "dataset_or_material_fingerprint":{"type":"string","minLength":1},
    "analysis_fingerprint":{"type":"string","minLength":1},
    "replication_status":{"type":"string","enum":["NOT_REPLICATED","PARTIAL","INDEPENDENT_REPLICATION","MULTI_SITE_REPLICATION"]},
    "result":{"type":"string","minLength":1},
    "limitations":{"type":"array","minItems":1,"items":{"type":"string"}},
    "pre_registration_ref":{"type":"string"},
    "raw_data_ref":{"type":"string"},
    "conflict_of_interest":{"type":"string"},
    "verification_state":{"type":"string","enum":["REGISTERED","UNVERIFIED","REVIEW","VERIFIED","BLOCKED"]}
  },
  "additionalProperties":false
}
