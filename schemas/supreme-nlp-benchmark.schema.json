{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://rampaulsaini.github.io/Shirmani-Research-Institute-Shirmani-Research-Institute-/schemas/supreme-nlp-benchmark.schema.json",
  "title":"Supreme NLP Benchmark Record",
  "description":"Evidence-first benchmark contract for multimodal NLP/ML/Automission research.",
  "type":"object",
  "additionalProperties":true,
  "required":["benchmark_id","task","dataset","metrics","provenance","verification"],
  "properties":{
    "benchmark_id":{"type":"string","minLength":1},
    "task":{"type":"string","minLength":1},
    "dataset":{"type":"object","required":["name","version"],"properties":{"name":{"type":"string"},"version":{"type":"string"},"sample_count":{"type":"integer","minimum":0}}},
    "metrics":{"type":"object","required":["primary"],"properties":{"primary":{"type":"number","minimum":0,"maximum":1},"precision":{"type":"number","minimum":0,"maximum":1},"recall":{"type":"number","minimum":0,"maximum":1},"f1":{"type":"number","minimum":0,"maximum":1},"calibration_error":{"type":"number","minimum":0,"maximum":1},"error_rate":{"type":"number","minimum":0,"maximum":1}}},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "uncertainty":{"type":"string"},
    "error_analysis":{"type":"array","items":{"type":"object"}},
    "provenance":{"type":"object","required":["source","model_version","timestamp"],"properties":{"source":{"type":"string"},"model_version":{"type":"string"},"timestamp":{"type":"string"}}},
    "verification":{"type":"object","required":["state","independent_verification"],"properties":{"state":{"type":"string"},"independent_verification":{"type":"boolean"},"reviewer":{"type":"string"},"evidence":{"type":"array","items":{"type":"string"}}}}
  }
}