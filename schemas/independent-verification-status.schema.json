{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SHIRMANI Independent Verification Status",
  "type": "object",
  "required": ["schema_version","generated_at","source","records_total","verified_records","unverified_records","review_records","blocked_records","verification_percent","status","integrity"],
  "properties": {
    "schema_version": {"type":"string"},
    "generated_at": {"type":"string"},
    "source": {"type":"object","required":["path","sha256"],"properties":{"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false},
    "records_total": {"type":"integer","minimum":0},
    "verified_records": {"type":"integer","minimum":0},
    "unverified_records": {"type":"integer","minimum":0},
    "review_records": {"type":"integer","minimum":0},
    "blocked_records": {"type":"integer","minimum":0},
    "verification_percent": {"type":"number","minimum":0,"maximum":100},
    "status": {"type":"string","enum":["NO_RECORDS","PARTIAL","VERIFIED_DATA_PRESENT"]},
    "integrity": {"type":"object","required":["fail_closed","workflow_success_is_not_verification","empty_source_is_zero_verified"],"properties":{"fail_closed":{"type":"boolean"},"workflow_success_is_not_verification":{"type":"boolean"},"empty_source_is_zero_verified":{"type":"boolean"}},"additionalProperties":false}
  },
  "additionalProperties": false
}
