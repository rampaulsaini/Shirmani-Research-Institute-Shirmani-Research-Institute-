{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SHIRMANI Supreme NLP Automission Health Record",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "repository",
    "contract_status",
    "operational_contract_status",
    "agent_orchestration_status",
    "schema_status",
    "governance_status",
    "graph_status",
    "regression_status",
    "verification_state",
    "blockers",
    "warnings",
    "provenance",
    "cycle_duration_seconds"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "contract_status": {"type": "string", "enum": ["PASS", "BLOCKED"]},
    "operational_contract_status": {"type": "string", "enum": ["PASS", "BLOCKED"]},
    "agent_orchestration_status": {"type": "string", "enum": ["PASS", "BLOCKED"]},
    "schema_status": {"type": "string", "enum": ["PASS", "BLOCKED"]},
    "governance_status": {"type": "string", "enum": ["PASS", "BLOCKED"]},
    "graph_status": {"type": "string", "enum": ["PASS", "BLOCKED"]},
    "regression_status": {"type": "string", "enum": ["PASS", "REVIEW", "BLOCKED"]},
    "verification_state": {"type": "string", "enum": ["REGISTERED", "UNVERIFIED", "REVIEW", "VERIFIED", "BLOCKED"]},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "array", "items": {"type": "string"}},
    "cycle_duration_seconds": {"type": "number", "minimum": 0}
  },
  "additionalProperties": false
}
