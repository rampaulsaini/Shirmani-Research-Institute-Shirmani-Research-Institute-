{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"SHIRMANI Supreme Agent Cycle",
  "type":"object",
  "required":["event_id","cycle_id","agent_id","agent_version","input_fingerprint","output_fingerprint","provenance","status","timestamp"],
  "properties":{
    "event_id":{"type":"string","minLength":1},
    "cycle_id":{"type":"string","minLength":1},
    "parent_event_id":{"type":"string"},
    "agent_id":{"type":"string","minLength":1},
    "agent_version":{"type":"string","minLength":1},
    "input_fingerprint":{"type":"string","minLength":1},
    "output_fingerprint":{"type":"string","minLength":1},
    "provenance":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "status":{"type":"string","enum":["REGISTERED","RUNNING","CHECKED","REVIEW","VERIFIED","UNVERIFIED","BLOCKED"]},
    "confidence":{"type":"string"},
    "uncertainty":{"type":"array","items":{"type":"string"}},
    "blockers":{"type":"array","items":{"type":"string"}},
    "timestamp":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
