{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Ultra Mega Infinity Quantum NLP Record",
  "type":"object",
  "required":["engine","cycle","interpretation","governance","fingerprint"],
  "properties":{
    "engine":{"const":"ultra-mega-infinity-quantum-nlp"},
    "cycle":{"type":"string","minLength":1},
    "interpretation":{"type":"object","required":["status","confidence","uncertainty","evidence_count","subjective_experience_claim"],
      "properties":{"status":{"enum":["NO_DATA","INSUFFICIENT_CONFIDENCE","INTERPRETED"]},"confidence":{"type":"number","minimum":0,"maximum":1},"uncertainty":{"type":"number","minimum":0,"maximum":1},"evidence_count":{"type":"integer","minimum":0},"subjective_experience_claim":{"const":false}}},
    "governance":{"type":"object","required":["fail_closed","subjective_experience_claim_allowed","independent_verification_required"],
      "properties":{"fail_closed":{"const":true},"subjective_experience_claim_allowed":{"const":false},"independent_verification_required":{"const":true}}},
    "fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
