  "quality_gates": [
    "transcription_accuracy",
    "context_accuracy",
    "evidence_correctness",
    "uncertainty_correctness",
    "voice_authorization",
    "lip_sync_alignment",
    "facial_naturalness",
    "respectful_language",
    "privacy",
    "reproducibility"
  ],
  "completion_definition": "voice input -> context understanding -> evidence/provenance decision -> response -> authorized voice output -> synchronized facial/lip presentation -> auditable result"
}
