{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rampaulsaini.github.io/Shirmani-Research-Institute-Shirmani-Research-Institute-/schemas/supreme-nlp-signal-record.schema.json",
  "title": "Supreme NLP Signal Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id","observed_at","source_type","observed_signal","inference","confidence","uncertainty","verification_status"],
  "properties": {
    "record_id": {"type":"string","minLength":1},
    "observed_at": {"type":"string","format":"date-time"},
    "source_type": {"type":"string","enum":["human","animal","plant","environment","machine","non_living","synthetic"]},
    "observed_signal": {"type":"string","minLength":1},
    "inference": {"type":"string","minLength":1},
    "plain_language_explanation": {"type":"string"},
    "confidence": {"type":"number","minimum":0,"maximum":1},
    "uncertainty": {"type":"string","minLength":1},
    "evidence_refs": {"type":"array","items":{"type":"string"}},
    "counter_evidence_refs": {"type":"array","items":{"type":"string"}},
    "verification_status": {"type":"string","enum":["UNVERIFIED","CHECKED","INDEPENDENTLY_VERIFIED","REJECTED"]},
    "model_version": {"type":"string"},
    "provenance": {"type":"array","items":{"type":"string"}}
  }
}