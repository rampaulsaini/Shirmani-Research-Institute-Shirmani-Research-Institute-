{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Supreme NLP Signal Observation",
  "type":"object",
  "additionalProperties":false,
  "required":["record_id","subject_type","modality","values","source","captured_at","evidence_hash"],
  "properties":{
    "record_id":{"type":"string"},
    "subject_type":{"enum":["HUMAN","ANIMAL","PLANT","MATERIAL","ENVIRONMENT","DEVICE","OTHER"]},
    "modality":{"enum":["TEXT","AUDIO","IMAGE","VIDEO","VIBRATION","ELECTRICAL","TEMPERATURE","LIGHT","CHEMICAL","MOTION","MULTIMODAL","OTHER"]},
    "values":{"type":"object","additionalProperties":{"type":"number"}},
    "unit":{"type":["string","null"]},
    "source":{"type":"string"},
    "captured_at":{"type":"string"},
    "context":{"type":"object"},
    "evidence_hash":{"type":"string","minLength":64,"maxLength":64}
  }
}
