{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SHIRMANI Supreme NLP Claim Evidence Record",
  "type": "object",
  "required": [
    "claim_id","source_text","operational_definition","comparison_scope",
    "evidence","counter_evidence","testability","limitations","verification_state"
  ],
  "properties": {
    "claim_id":{"type":"string","minLength":1},
    "source_text":{"type":"string","minLength":1},
    "operational_definition":{"type":"string","minLength":1},
    "comparison_scope":{"type":"string","minLength":1},
    "evidence":{"type":"array","items":{"type":"string"}},
    "counter_evidence":{"type":"array","items":{"type":"string"}},
    "testability":{"type":"string","minLength":1},
    "limitations":{"type":"array","items":{"type":"string"}},
    "model_inference":{"type":"string"},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "provenance":{"type":"array","items":{"type":"string"}},
    "verification_state":{
      "type":"string",
      "enum":["REGISTERED","UNVERIFIED","REVIEW","VERIFIED","BLOCKED"]
    }
  },
  "additionalProperties":false
}
