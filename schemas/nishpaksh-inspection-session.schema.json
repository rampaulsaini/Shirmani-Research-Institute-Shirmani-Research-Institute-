{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Nishpaksh Inspection Session",
  "type":"object",
  "required":["session_id","purpose","scope","status","evidence"],
  "properties":{
    "session_id":{"type":"string"},
    "purpose":{"type":"string","enum":["self_observation","education","role_assessment","public_role_assessment","human_centered_inquiry"]},
    "scope":{"type":"array","items":{"type":"string"}},
    "consent":{"type":"object","properties":{"status":{"enum":["not_required","pending","granted","withdrawn"]},"version":{"type":"string"}},"required":["status"]},
    "inputs":{"type":"array","items":{"type":"object","properties":{"type":{"type":"string"},"provenance":{"type":"string"},"retention":{"type":"string"}},"required":["type"]}},
    "biometric":{"type":"object","properties":{"used":{"type":"boolean"},"modality":{"type":"array","items":{"type":"string","enum":["finger_vein","iris","face","voice","other"]}},"raw_retained":{"type":"boolean"}}},
    "analysis":{"type":"array","items":{"type":"object","properties":{"dimension":{"type":"string"},"method":{"type":"string"},"model_version":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1}},"required":["dimension","method"]}},
    "evidence":{"type":"array","items":{"type":"object","properties":{"claim":{"type":"string"},"source":{"type":"string"},"independent":{"type":"boolean"},"uncertainty":{"type":"string"}},"required":["claim","source"]}},
    "human_review":{"type":"object","properties":{"required":{"type":"boolean"},"completed":{"type":"boolean"},"reviewer_count":{"type":"integer","minimum":0}}},
    "status":{"type":"string","enum":["REGISTERED","CHECK","VERIFIED","NOT_VERIFIED","INSUFFICIENT_EVIDENCE","DISPUTED","REVOKED"]},
    "certificate":{"type":"object","properties":{"scope":{"type":"string"},"issued_at":{"type":"string"},"expires_at":{"type":"string"},"evidence_snapshot":{"type":"string"}}},
    "appeal":{"type":"object","properties":{"available":{"type":"boolean"},"status":{"type":"string"}}}
  }
}