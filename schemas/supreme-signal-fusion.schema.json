{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rampaulsaini.github.io/Shirmani-Research-Institute-Shirmani-Research-Institute-/schemas/supreme-signal-fusion.schema.json",
  "title": "Supreme Signal Fusion Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_version","status","observed_signal","inference","verification","governance","provenance","limitations"],
  "properties": {
    "record_version": {"type":"string","minLength":1},
    "status": {"type":"string","enum":["INSUFFICIENT_DATA","PRELIMINARY_INTERPRETATION","EVIDENCE_SUPPORTED_INTERPRETATION"]},
    "observed_signal": {"type":"object","additionalProperties":false,"required":["count","source_types","modalities","independent_sources"],"properties":{"count":{"type":"integer","minimum":0},"source_types":{"type":"array","items":{"type":"string"}},"modalities":{"type":"array","items":{"type":"string"}},"independent_sources":{"type":"integer","minimum":0}}},
    "inference": {"type":"object","additionalProperties":false,"required":["plain_language","confidence","agreement","mean_quality"],"properties":{"plain_language":{"type":"string","minLength":1},"confidence":{"type":"number","minimum":0,"maximum":1},"agreement":{"type":"number","minimum":0,"maximum":1},"mean_quality":{"type":"number","minimum":0,"maximum":1}}},
    "verification": {"type":"object","additionalProperties":false,"required":["status","independent_verification_required","counter_evidence_required"],"properties":{"status":{"type":"string","enum":["UNVERIFIED","CHECKED","INDEPENDENTLY_VERIFIED","REJECTED"]},"independent_verification_required":{"type":"boolean"},"counter_evidence_required":{"type":"boolean"}}},
    "governance": {"type":"object","additionalProperties":false,"required":["fail_closed","subjective_experience_claim_allowed","scheduled_code_mutation_allowed"],"properties":{"fail_closed":{"type":"boolean"},"subjective_experience_claim_allowed":{"type":"boolean"},"scheduled_code_mutation_allowed":{"type":"boolean"}}},
    "provenance": {"type":"object"},
    "limitations": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
  }
}
