{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Supreme NLP Evidence-Bound Interpretation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "observation_hash",
    "statement",
    "hypotheses",
    "confidence",
    "evidence_level",
    "limitations",
    "verification_status",
    "generated_at"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "observation_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "statement": {"type": "string", "minLength": 1},
    "hypotheses": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_level": {
      "enum": ["observational", "correlational", "validated", "unknown"]
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "verification_status": {
      "enum": ["UNVERIFIED", "INDEPENDENTLY_VERIFIED", "REJECTED"]
    },
    "generated_at": {"type": "string", "minLength": 1}
  }
}
