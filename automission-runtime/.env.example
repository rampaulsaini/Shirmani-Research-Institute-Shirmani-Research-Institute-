# Comma-separated HTTPS JSON feeds. Each feed returns a JSON array or {"items":[...]}.
# Each item must include title and channel, and should include url/evidence_url.
AUTOMISSION_SOURCE_FEEDS=
AUTOMISSION_HEARTBEAT_SECONDS=300
AUTOMISSION_STALE_PROCESSING_SECONDS=1800
AUTOMISSION_MAX_CONSECUTIVE_FAILURES=3
AUTOMISSION_ADAPTER_ALLOWLIST=
AUTOMISSION_RUN_ONCE=false

# Optional channel adapter module names. Keep credentials outside Git.
AUTOMISSION_EMPLOYMENT_ADAPTER=
AUTOMISSION_FREELANCING_ADAPTER=
AUTOMISSION_AI_MARKETING_ADAPTER=
AUTOMISSION_DIGITAL_STORE_ADAPTER=
AUTOMISSION_YATHARTH_AI_MUSIC_ADAPTER=
AUTOMISSION_ECONOMIC_VISION_ADAPTER=
