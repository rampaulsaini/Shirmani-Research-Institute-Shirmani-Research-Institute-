{"$schema":"https://json-schema.org/draft/2020-12/schema","schema_version":"1.0.0","name":"꙰\"𝒥शिरोमणि Work Execution & Fulfilment Tracking","status":"DESIGN_SPECIFICATION_NO_LIVE_EXECUTION","type":"object","properties":{"work_execution_id":{"type":"string"},"agreement_reference":{"type":["string","null"]},"worker_reference":{"type":["string","null"]},"counterparty_reference":{"type":["string","null"]},"scope_reference":{"type":["string","null"]},"milestone_reference":{"type":["string","null"]},"deliverable_reference":{"type":["string","null"]},"evidence_reference":{"type":["string","null"]},"review_reference":{"type":["string","null"]},"fulfilment_reference":{"type":["string","null"]},"pipeline_reference":{"type":["string","null"]},"execution_status":{"type":"string","enum":["WORK_READY","STARTED","IN_PROGRESS","MILESTONE_SUBMITTED","EVIDENCE_REVIEW","ACCEPTED","FULFILLED","REVISION_REQUIRED","DISPUTED","PAUSED","CANCELLED","TERMINATED","NOT_VERIFIED","ARCHIVED"]}},"required":["work_execution_id","execution_status"],"rules":{"invented_work":false,"invented_deliverable":false,"invented_milestone":false,"invented_evidence":false,"invented_acceptance":false,"invented_payment":false,"invented_income":false,"automatic_completion":false,"automatic_acceptance":false,"automatic_payment":false,"automatic_income_recording":false,"identity_substitution":false,"silent_overwrite":false},"human_review_required":["worker_identity","counterparty_confirmation","scope","milestones","deliverables","evidence","acceptance","disputes","payments","production_deployment"],"evidence_rule":"Work completion, acceptance, payment and income must not be treated as factual without appropriate source or external evidence.","privacy_boundary":"Store only necessary work, party references, deliverable metadata and evidence references.","integrity_statements":["WORK_STARTED != WORK_COMPLETED","SUBMITTED != ACCEPTED","ACCEPTED != PAID","FULFILLED != INCOME CLAIM"],"integrations":["federation/agreement-work-contract-record.schema.json","federation/verified-work.schema.json","federation/work-to-value-employment-income.schema.json","federation/settlement-records.schema.json","federation/reconciliation-audit-trail.schema.json","employment.html","income-hub.html"]}