{
  "schema_version": "1.0",
  "record_type": "research_paper_evidence_intake_spec",
  "source": "federation/research-paper-source-intake.json",
  "claims": "generated/research-paper-claims.json",
  "output": "generated/research-paper-evidence-intake.jsonl",
  "rule": "One intake record per registered claim.",
  "required_fields": [
    "intake_id",
    "claim_id",
    "source_repository",
    "source_ref",
    "category",
    "claim",
    "claim_status",
    "verification_status",
    "verification_required",
    "independent_verification_required",
    "evidence_requirements",
    "evidence_status",
    "promotion_status"
  ],
  "fixed_values": {
    "verification_status": "UNVERIFIED",
    "verification_required": true,
    "independent_verification_required": true,
    "evidence_status": "REQUIRED",
    "promotion_status": "BLOCKED_PENDING_INDEPENDENT_VERIFICATION"
  },
  "boundary": "Intake and traceability records do not establish truth or independent verification."
}
