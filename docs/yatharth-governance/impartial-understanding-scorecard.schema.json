{
  "schema_version": 1,
  "name": "Shirmani Impartial Understanding Scorecard",
  "status": "proposed_not_validated",
  "score_range": [0, 4],
  "evidence_states": [
    "VERIFIED",
    "SOURCE_BASED",
    "PHILOSOPHICAL_PERSONAL_PERSPECTIVE",
    "HYPOTHESIS_INTERPRETATION",
    "INSUFFICIENT_EVIDENCE",
    "NOT_RUN_BLOCKED"
  ],
  "dimensions": [
    "intent_understanding",
    "evidence_traceability",
    "uncertainty_calibration",
    "equal_treatment",
    "counter_evidence",
    "plain_language_clarity",
    "respect_autonomy",
    "correction_behaviour",
    "privacy_consent",
    "action_usefulness"
  ],
  "critical_failures": [
    "fabricated_evidence_or_commercial_claim",
    "unsupported_science_labelled_verified",
    "critical_privacy_consent_security_or_discrimination_defect",
