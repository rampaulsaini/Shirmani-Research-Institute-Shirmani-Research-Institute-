{
  "schema_version": "1.0.0",
  "reviewed": "2026-10-01",
  "purpose": "Make AI/ML/NLP result quality safer and more accurate by requiring calibrated confidence, disagreement detection, abstention and independent evaluation.",
  "decision_pipeline": [
    "input_validation",
    "task_routing",
    "model_execution",
    "independent_cross_check",
    "disagreement_analysis",
    "confidence_calibration",
    "abstain_when_threshold_not_met",
    "human_review_when_high_impact",
    "traceable_output"
  ],
  "quality_rules": {
    "confidence_must_not_be_presented_as_probability_without_calibration": true,
    "model_disagreement_must_be_visible": true,
    "low_confidence_must_allow_abstention": true,
    "unknown_or_ambiguous_input_must_not_be_forced_into_a_class": true,
    "evaluation_must_include_unseen_test_data": true,
    "evaluation_must_be_separated_from_training_data": true,
    "regression_tests_must_run_before_release": true,
    "high_impact_output_requires_human_review": true
  },
  "metrics": [
    "accuracy",
    "precision",
    "recall",
    "f1",
    "calibration_error",
    "abstention_rate",
    "selective_risk",
    "disagreement_rate",
    "p50_latency",
    "p95_latency",
    "p99_latency"
  ],
  "release_boundary": {
    "accuracy_is_not_truth": true,
    "confidence_is_not_certainty": true,
    "ensemble_agreement_is_not_independent_verification": true,
    "benchmark_success_is_not_real_world_guarantee": true,
    "independent_verified_claims": 0,
    "live_claim": false
  }
}
