{
  "version": 2,
  "hub": "rampaulsaini/Shirmani-Research-Institute-Shirmani-Research-Institute-",
  "agents": [
    {
      "id": "research",
      "role": "source-grounded research drafting",
      "input": "canonical source units + reasoning records",
      "output": "research drafts",
      "status": "planned"
    },
    {
      "id": "mahagranth",
      "role": "long-form book composition",
      "input": "reviewed source units",
      "output": "book drafts",
      "status": "planned"
    },
    {
      "id": "verse",
      "role": "गीत/श्लोक/सूत्र composition",
      "input": "source units + reasoning records",
      "output": "verse records",
      "status": "planned"
    },
    {
      "id": "paper",
      "role": "research-paper drafting",
      "input": "source units + evidence metadata + reasoning",
      "output": "paper drafts",
      "status": "planned"
    },
    {
      "id": "certificate",
      "role": "archival certificate generation",
      "input": "approved records",
      "output": "certificates",
      "status": "planned"
    },
    {
      "id": "audio",
      "role": "audio-ready script generation",
      "input": "approved text",
      "output": "audio scripts",
      "status": "planned"
    },
    {
      "id": "translation",
      "role": "multilingual transformation",
      "input": "approved text",
      "output": "translations",
      "status": "planned"
    },
    {
      "id": "quality",
      "role": "schema, duplicate and provenance checks",
      "input": "all candidate outputs",
      "output": "QC reports",
      "status": "planned"
    },
    {
      "id": "shirmani-reasoning",
      "role": "deterministic epistemic reasoning and verification planning",
      "input": "canonical source claims + framework policy",
      "output": "reasoning records with claim class, methods, counterevidence prompts and review status",
      "status": "ready",
      "source": "factory/agents/shirmani_reasoning_agent.py",
      "framework": "factory/shirmani-framework.json"
    }
  ],
  "policy": {
    "source_first": true,
    "generated_output_is_not_source": true,
    "research_requires_independent_verification": true,
    "no_claim_of_scientific_validation": true,
    "free_first": true,
    "philosophical_claims_must_be_labeled": true,
    "human_agency_preserved": true,
    "provenance_required": true
  }
}
