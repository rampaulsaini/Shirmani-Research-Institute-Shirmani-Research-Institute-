{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shirmani Reasoning Manifest Record",
  "type": "object",
  "required": ["artifact_id","kind","content_sha256","source_ids","reasoning","claim_class","method_trace","evidence_status","human_review_required","verification_questions"],
  "properties": {
    "artifact_id": {"type":"string"},
    "kind": {"enum":["verse","book","research-paper"]},
    "content_sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "source_ids": {"type":"array","items":{"type":"string"}},
    "claim_class": {"type":"string"},
    "method_trace": {"type":"array","minItems":1,"items":{"type":"string"}},
    "evidence_status": {"type":"string"},
    "human_review_required": {"type":"boolean"},
    "verification_questions": {"type":"array","minItems":1,"items":{"type":"string"}},
    "reasoning": {"type":"object","required":["id","framework_id","claim_class","method_trace","evidence_status","human_review_required"]}
  }
}